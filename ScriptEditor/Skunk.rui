      <script>! _SkUpdate</script>
    </macro_item>
    <macro_item guid="9f662055-f680-5996-9b27-136a83e0ea2c" bitmap_id="ff4bf669-03e7-5b89-b057-e1bd5559887b">
      <button_text>
        <locale_1033>Settings</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Settings</locale_1033>
      </menu_text>
      <tooltip>
        <locale_1033>Settings: annotation scale (view scale), plan cut, keyboard aliases, start with Rhino</locale_1033>
      </tooltip>
      <script>! _SkSettings</script>
    </macro_item>
    <macro_item guid="7946266c-ea13-5f34-88d7-19448a2f22e7" bitmap_id="09ab83a6-73c9-5e2a-b9a5-adae0f596b29">
      <button_text>
        <locale_1033>Skunk</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Skunk</locale_1033>
      </menu_text>
      <tooltip>
        <locale_1033>Skunk: load Skunk, start live updates and show the Skunk toolbar (add Skunk to Rhino's startup commands)</locale_1033>
      </tooltip>
      <script>! _Skunk</script>
    </macro_item>
    <macro_item guid="b1ccb703-6616-5992-a2c4-04ddcc9fe905" bitmap_id="8792aee1-5875-56d8-8f00-efb4737bb5f3">
      <button_text>
        <locale_1033>Orientation</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Orientation</locale_1033>
      </menu_text>
      <tooltip>
        <locale_1033>Orientation: turn the plan view so true north points up</locale_1033>
      </tooltip>
      <script>! _SkOrientView _Orientation=TrueNorth _Enter</script>
    </macro_item>
    <macro_item guid="9bc7ea27-11cc-5fed-8a5b-eb91013b792f" bitmap_id="8792aee1-5875-56d8-8f00-efb4737bb5f3">
      <button_text>
        <locale_1033>Orientation</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Orientation</locale_1033>
      </menu_text>
      <tooltip>
        <locale_1033>Turn the plan view so project north points up</locale_1033>
      </tooltip>
      <script>! _SkOrientView _Orientation=ProjectNorth _Enter</script>
    </macro_item>
    <macro_item guid="2dfa4827-5f9c-57f5-b213-18932e97250c" bitmap_id="88676b4d-6976-5584-873c-0fe694fb02a2">
      <button_text>
        <locale_1033>Site Points</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Site Points</locale_1033>
      </menu_text>
      <tooltip>
        <locale_1033>Show / hide the internal origin, project base point and survey point</locale_1033>
      </tooltip>
      <script>! _SkShowSite</script>
    </macro_item>
