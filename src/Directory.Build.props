<Project>
  <!-- Keep build files off the synced cloud folder (the Release engine is copied to ScriptEditor\shared). -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\Skunk-build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\Skunk-build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <!--
      Compile against RhinoCommon 9.0.26300.9401 from NuGet: the oldest Rhino 9 the builds load in
      (same as FileIO). -p:UseLocalRhino=true compiles against the installed Rhino 9 instead.
    -->
    <RhinoCommonVersion>9.0.26300.9401</RhinoCommonVersion>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">C:\Program Files\Rhino 9\System</RhinoSystemDir>
    <UseLocalRhino Condition="'$(UseLocalRhino)' == ''">false</UseLocalRhino>
  </PropertyGroup>
  <!-- Version of every build, generated by tools/gen_project.py from the rhproj identity.version. -->
  <Import Project="$(MSBuildThisFileDirectory)Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Version.props')" />
</Project>
