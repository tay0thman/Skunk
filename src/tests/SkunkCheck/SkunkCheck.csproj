<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless Rhino 9 (Rhino.Inside) checks of the Skunk engine: unit formatting, coordinate systems,
    levels, spots, the dependency updates the event service performs. Never loads the plug-in into
    the user's Rhino. Needs Rhino 9 installed and licensed on this machine.

      dotnet build src\tests\SkunkCheck -c Release -o "%LOCALAPPDATA%\Skunk-build\SkunkCheck"
      "%LOCALAPPDATA%\Skunk-build\SkunkCheck\SkunkCheck.exe"                          (all engine checks, .NET 8)

    Script Editor project check (load + Script Editor package build + RhinoCode probes). RhinoCode
    only loads on .NET 10, so run the same build on the .NET 10 runtime:
      set DOTNET_ROLL_FORWARD=LatestMajor
      dotnet "%LOCALAPPDATA%\Skunk-build\SkunkCheck\SkunkCheck.dll" rhproj ScriptEditor\Skunk.rhproj package
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Skunk.Core\Skunk.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRhino)' == 'true'">
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRhino)' != 'true'">
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonVersion)" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
