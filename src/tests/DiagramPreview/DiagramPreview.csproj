<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pictures of the SkGridBubbles dialog's diagram, drawn by the dialog's own code (GridBubblesDialog.SavePicture)
    with Rhino's Eto and its WPF platform, outside Rhino: headless Rhino has no Eto platform, so SkunkCheck cannot
    draw it. Look at the PNGs after changing the drawing:

      dotnet build src\tests\DiagramPreview -c Release -o "%LOCALAPPDATA%\Skunk-build\DiagramPreview"
      "%LOCALAPPDATA%\Skunk-build\DiagramPreview\DiagramPreview.exe" <folder for the pictures>
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701;MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Skunk.Core\Skunk.Core.csproj" />
    <Reference Include="Eto"><HintPath>$(RhinoSystemDir)\Eto.dll</HintPath></Reference>
    <Reference Include="Eto.Wpf"><HintPath>$(RhinoSystemDir)\Eto.Wpf.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRhino)' == 'true'">
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystemDir)\netcore\RhinoCommon.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRhino)' != 'true'">
    <PackageReference Include="RhinoCommon" Version="$(RhinoCommonVersion)" />
  </ItemGroup>
</Project>
